<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The guest runs under this app's UID, so its sockets are the app's: this
      covers the runtime download at first use and every connection a JAR makes,
      listening included. A JAR's own manifest permissions are not merged here.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      A JAR that listens is a server, and the point of serving is that other
      devices reach it. Since Android 17 (API 37) the platform gates an app's
      local-network traffic behind this runtime permission: without it,
      connections from another device are dropped while the phone's own
      connections — loopback, and its own LAN address, which the kernel delivers
      locally — keep working. A guest then looks alive to the phone and is
      unreachable to everything else. See the request made when a run starts.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!--
      A JAR that serves requests has to keep serving after the user leaves the
      app, and Android freezes a process that is merely backgrounded. Hosting the
      guest in a foreground service is what stops that.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      No storage permission is declared. A picked JAR is read through the
      document picker, which grants this app access to that one file, and a
      run's working directory is the app's own — neither needs one. The guide
      screen tells the user the same thing, so it has to stay true; the two are
      kept in step by RunPermissions and its test.
    -->

    <!--
      Predictive back is on by default from targetSdk 35 and this app targets
      above that; it is declared all the same, because the two screens that
      replace the window — the permission guide and About — follow the gesture
      themselves, and this is the flag that has back routed through the
      dispatcher they register with.
    -->
    <application
        android:allowBackup="true"
        android:allowNativeHeapPointerTagging="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.RunJar">
        <!--
          Portrait, and it stays portrait. The run screen is one column — a form
          above the console — and the console keeps a floor of its own height
          whatever the window does; a turn to landscape makes that column wider
          than it is tall, so the console takes the height and the form is
          pushed out of the window it was meant to share. The two screens below
          are locked with this one, so backing out of them is not a turn either.

          On a large screen this is a request the platform need not honour:
          since Android 16 (API 36) a device with the ignore-orientation display
          setting treats screenOrientation as a hint, and the manifest property
          that opts an app back in (PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY)
          is ignored at targetSdk 37, which this app targets. On a phone the lock
          is what the platform does; on a tablet or a foldable the platform
          decides.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.RunJar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The two screens that explain the app are activities of their own rather
          than another state of the run screen. Back from them is then a real
          cross-activity back, which is the only kind the platform can preview
          truthfully: it slides the run screen in behind them while the gesture
          is made, instead of promising a return to the home screen and then not
          leaving the app. Neither registers a back callback, and nothing in the
          app draws the animation.
        -->
        <activity
            android:name=".PermissionGuideActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.RunJar" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.RunJar" />

        <!--
          The guest JVM lives in its own process. A JVM fault in the guest (or a
          JAR that aborts the VM) then takes down only this process, not the UI.
        -->
        <service
            android:name=".jvm.JvmService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":jvm">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-supplied Java application, which may serve network requests." />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
